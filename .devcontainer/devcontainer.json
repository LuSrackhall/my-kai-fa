{
  // ============================================================
  // 容器名称 — 在 VS Code 左下角显示
  // ============================================================
  "name": "Safe Agent Dev",

  // ============================================================
  // 镜像构建 — 使用项目本地的 Dockerfile
  // context: ".." 将构建上下文设为项目根目录
  // ============================================================
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },

  // ============================================================
  // 固定挂载点 — 长久交互区（唯一挂载，安全边界）
  //
  // 宿主机路径由环境变量 DSH_SAFE_DIR 决定,未设置时回退到 ~/dsh-safe:
  //   macOS:   /Volumes/SSD980/dsh-safe (本机) 或 /Users/<用户名>/dsh-safe
  //   Linux:   /home/<用户名>/dsh-safe
  //
  // 隔离原则:
  //   - 这是容器可见的唯一宿主机目录,容器内的一切写入若需持久化,
  //     都应放在 /workspaces/dsh-safe 内。
  //   - 不挂载宿主机 .ssh / .gitconfig 等敏感文件(防读取外带);
  //     Git 身份配置持久化在 <DSH_SAFE_DIR>/git/gitconfig,见 init-env.sh。
  //
  // 路径不存在的处理:
  //   Docker 会直接报错并拒绝启动容器。请先创建:
  //     mkdir -p "${DSH_SAFE_DIR:-$HOME/dsh-safe}"
  // ============================================================
  "mounts": [
    "source=${localEnv:DSH_SAFE_DIR:${localEnv:HOME}/dsh-safe},target=/workspaces/dsh-safe,type=bind,consistency=cached"
  ],

  // ============================================================
  // Features — 微软维护的即插即用功能模块
  // 文档: https://containers.dev/features
  // ============================================================
  "features": {

    // Git: 容器内自带 git 工具
    "ghcr.io/devcontainers/features/git:1": {},

    // Common Utilities: Zsh / curl / git / less 等常用工具
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode",
      "uid": "1000"
    }

    // 安全说明: 不引入 docker-outside-of-docker。
    // docker.sock 等于宿主机 Docker 的总控制开关,容器内 agent 可借它
    // 再起挂载任意路径的容器,绕过"仅可操作挂载目录"的隔离边界。
    // 语言运行时 (Node/Python/Go/Rust) 不在此处配置。
    // 它们已通过版本管理器预装在 Dockerfile 镜像层中，
    // 由 init-env.sh 在 Shell 启动时统一激活。
  },

  // ============================================================
  // VS Code 自定义设置
  // ============================================================
  "customizations": {
    "vscode": {

      // 编辑器设置
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "editor.formatOnSave": true,
        "files.autoSave": "onFocusChange"
      },

      // 自动安装的扩展
      "extensions": [
        "dbaeumer.vscode-eslint",          // ESLint
        "esbenp.prettier-vscode",           // Prettier
        "ms-python.python",                 // Python
        "golang.go",                        // Go
        "rust-lang.rust-analyzer"           // Rust
      ]
    }
  },

  // ============================================================
  // 网络 — 独立网络 + 仅开放 dsh web GUI 端口
  //
  // 不使用 --network=host: host 模式会让容器内 agent 访问到
  // 宿主机本机运行的其他服务与局域网,破坏隔离。
  // forwardPorts 仅把容器的 3080 端口(dsh web GUI 默认端口)
  // 转发到宿主机 localhost;若 dsh 使用其他端口,在此追加即可。
  // ============================================================
  "forwardPorts": [3080],
  "portsAttributes": {
    "3080": {
      "label": "dsh web GUI",
      "onAutoForward": "openBrowser"
    }
  },

  // ============================================================
  // 容器创建完成后执行
  // ============================================================
  "postCreateCommand": "source /usr/local/bin/init-env.sh && echo 'Dev container ready.' && zsh"
}
